# --- Backend ---
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./horariopro.db
SECRET_KEY="change-me-generate-with-openssl-rand-base64-32"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Primer usuario (Docker). Obligatorio para login en http://localhost:8080
BOOTSTRAP_USER_EMAIL=tu@email.com
BOOTSTRAP_USER_PASSWORD=elige-una-contraseña-segura

# Producción con PostgreSQL (perfil postgres)
# DATABASE_URL=postgresql://horario_app:CHANGE_ME@horario-db:5432/horario_pro
# POSTGRES_DB=horario_pro
# POSTGRES_USER=horario_app
# POSTGRES_PASSWORD=CHANGE_ME

# --- Frontend (build Docker) ---
# Local:
VITE_API_BASE_URL=http://localhost:8000
# VPS (mismo origen, Nginx hace proxy /api):
# VITE_API_BASE_URL=/api

# --- VPS (nginx-proxy + gastodehoy_backend) ---
# DOCKER_PROXY_NETWORK=gastodehoy_backend
# APP_DOMAIN=workshift.andreacruz.es
# APP_BASE_URL=https://workshift.andreacruz.es
# CORS_ORIGINS=https://workshift.andreacruz.es
# Ver deploy/nginx-proxy/README.md
