# --- Backend ---
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./horariopro.db
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Producción con PostgreSQL (perfil postgres)
# DATABASE_URL=postgresql://horario_app:CHANGE_ME@horario-db:5432/horario_pro
# POSTGRES_DB=horario_pro
# POSTGRES_USER=horario_app
# POSTGRES_PASSWORD=CHANGE_ME

# --- Frontend (build Docker / Vite) ---
VITE_API_BASE_URL=http://localhost:8000
# En VPS detrás de Nginx: VITE_API_BASE_URL=https://tu-dominio.com/api

# Solo pruebas locales en contenedor (override)
# VITE_DEV_BYPASS_AUTH=true

# --- VPS (referencia; Nginx en el host) ---
# APP_BASE_URL=https://horario.ejemplo.com
# Proxy: / -> horario-frontend:80, /api -> horario-backend:8000
